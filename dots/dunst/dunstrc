[global]
    # --- Posição e Dimensões (Mantidas) ---
    origin = top-right
    offset = 10x50
    alignment = right
    width = 300
    height = 100
    padding = 5
    horizontal_padding = 8
    frame_width = 2
    separator_height = 2

    # --- Fontes (Mantidas) ---
    font = FiraCode Nerd Font Propo 10
    line_height = 0

    # --- Comportamento (Mantido) ---
    idle_threshold = 120
    ignore_dbusclose = false
    show_age_threshold = 60
    sticky_history = true
    history_length = 20
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    shrink = no
    notification_limit = 5
    
    # ============================
    # --- TEMA ROXO ---
    # ============================
    
    # --- Cores Globais ---
    background = "#0C0012"
    foreground = "#CBC9CC"
    frame_color = "#9C90AA" # Lavanda para a borda padrão
    separator_color = "#443A67" # Roxo escuro para a linha divisória
    
    # --- Transparência ---
    # Valor de 0 (opaco) a 100 (invisível). 15 é um bom valor inicial.
    transparency = 15

# --- Urgência Baixa (ex: mudança de música) ---
# Cores mais sutis para não distrair.
[urgency_low]
    background = "#211E46" # Fundo um pouco mais claro
    foreground = "#9C90AA" # Texto lavanda
    frame_color = "#443A67" # Borda roxo escuro
    timeout = 5

# --- Urgência Normal (padrão) ---
# Usa as cores globais.
[urgency_normal]
    background = "#0C0012"
    foreground = "#CBC9CC"
    frame_color = "#9C90AA"
    timeout = 10

# --- Urgência Crítica (ex: bateria fraca) ---
# Borda vermelha para chamar atenção máxima.
[urgency_critical]
    background = "#0C0012"
    foreground = "#F38BA8" # Texto vermelho para combinar com a borda
    frame_color = "#F38BA8" # Um vermelho vibrante, mas estiloso
    timeout = 0
