{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/arch.txt",
        "color": {
            "1": "1"
        },
        "padding": {
            "top": 2,
            "right": 6
        }
    },
    "display": {
        "separator": ""
    },
    // CORRIGIDO: O bloco "colors" foi movido para o nível principal
    "colors": {
        "1": "#BE95FF", // Roxo Vibrante
        "2": "#9C90AA", // Lavanda
        "3": "#CBC9CC"  // Cinza Claro (Texto)
    },
    "modules": [
        "break",
        "break",
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "1"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "1"
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
            "keyColor": "1"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "1"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "1"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "1"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "1"
        },
        {
            "type": "media",
            "key": "󰝚 ",
            "keyColor": "1"
        },
        "break",
        {
            "type": "colors",
            "colors": [
                "#0C0012",
                "#211E46",
                "#443A67",
                "#6E6189",
                "#9C90AA",
                "#BE95FF",
                "#CBC9CC"
            ]
        }
    ]
}
