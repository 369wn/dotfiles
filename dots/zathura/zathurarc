# --- Configs ---
set selection-clipboard clipboard
set window-title-home-tilde true
set statusbar-home-tilde true
set adjust-open "best-fit"
set adjust-open width
set guioptions none

# --- Keybinds ---
map <C-Tab> toggle_statusbar
map i recolor

# ================================================
# --- TEMA ROXO (VERSÃO ESCURA) ---
# ================================================

# NOVO FUNDO - Um roxo mais escuro, próximo do preto.
set default-bg                      "#0C0012"
# Texto principal
set default-fg                      "#D9A8FA"

# Autocompletar da barra de comandos
set completion-bg                   "#0C0012" # NOVO FUNDO
set completion-fg                   "#D9A8FA"
set completion-highlight-bg         "#BE95FF"
set completion-highlight-fg         "#0C0012" # NOVO FUNDO (para texto do destaque)
set completion-group-bg             "#0C0012" # NOVO FUNDO
set completion-group-fg             "#9C90AA"

# Barra de Status
set statusbar-fg                    "#D9A8FA"
set statusbar-bg                    "#0C0012" # NOVO FUNDO

# Notificações
set notification-bg                 "#0C0012" # NOVO FUNDO
set notification-fg                 "#D9A8FA"
set notification-error-bg           "#0C0012" # NOVO FUNDO
set notification-error-fg           "#ED8796"
set notification-warning-bg         "#0C0012" # NOVO FUNDO
set notification-warning-fg         "#FAE3B0"

# Barra de entrada de comandos
set inputbar-fg                     "#D9A8FA"
set inputbar-bg                     "#0C0012" # NOVO FUNDO

# Índice/Sumário do PDF
set index-fg                        "#9C90AA"
set index-bg                        "#0C0012" # NOVO FUNDO
set index-active-fg                 "#BE95FF"
set index-active-bg                 "#443A67" # Mantido um roxo um pouco mais claro para contraste

# Animação de carregamento
set render-loading-bg               "#0C0012" # NOVO FUNDO
set render-loading-fg               "#D9A8FA"

# --- Configurações do Modo Recolor (COM TRANSPARÊNCIA) ---
# Mantido como transparente, conforme seu último pedido.
# O "branco" do PDF vira transparente
set recolor-lightcolor "rgba(0, 0, 0, 0)"
# O "preto" do PDF vira branco sólido
set recolor-darkcolor "rgba(255, 255, 255, 1)"

set recolor true
